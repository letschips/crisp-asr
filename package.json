{
  "name": "crisp-asr",
  "version": "0.4.2",
  "description": "Doubao speech recognition for Obsidian with optional multi-provider AI polishing and extraction.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "deploy": "node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "asr",
    "speech-to-text",
    "doubao"
  ],
  "author": "小红书 letschips",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0",
    "obsidian": "^1.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
